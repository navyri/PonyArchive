# PonyArchive — ejemplo de variables de entorno
# Copia este archivo como `backend/.env` y rellena tus valores.
# NUNCA subas el archivo .env real al repositorio (está en .gitignore).

# ---------------- Backend (FastAPI) ----------------
APP_ENV=dev

# Clave para firmar los JWT locales. Debe tener al menos 32 caracteres.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-por-una-propia-de-mas-de-32-caracteres

# Proveedor de autenticación: "local" (JWT propio) o "keycloak" (DEC-05)
AUTH_PROVIDER=local

# Configuración de Keycloak (solo si AUTH_PROVIDER=keycloak)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ponyarchive
KEYCLOAK_CLIENT_ID=ponyarchive-backend
KEYCLOAK_CLIENT_SECRET=

# ---------------- Modelo local (Ollama) ----------------
# Debe estar ejecutándose en la máquina del equipo (DEC-06: túnel en la demo).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=30m

# ---------------- Base de datos vectorial ----------------
VECTOR_DIR=./vectorstore
COLLECTION_NAME=ponyarchive
TOP_K=6
# Umbral mínimo de similitud aceptada. Si no se define, se calibra solo según
# EMBEDDINGS_PROVIDER: 0.62 con e5 local y 0.50 con OpenAI.
# SIMILARITY_THRESHOLD=0.62

# ---------------- Persistencia ----------------
DATABASE_URL=sqlite:///./data/ponyarchive.db

# ---------------- CORS ----------------
# Orígenes permitidos, separados por coma (el frontend en desarrollo usa 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---------------- Integración externa ----------------
# Fuente de metadatos: datos bajo licencia CC BY-SA 3.0 (atribución obligatoria)
PONY_API_URL=https://ponyapi.net/v1

# Si es True, al arrancar importa el catálogo de Pony API cuando la biblioteca está
# vacía. Pensado para despliegues efímeros sin volumen persistente (p. ej. Hugging Face
# Spaces en free tier), donde cada reinicio parte de una base vacía. Déjalo en False
# en local o en docker-compose con volumen, para no reimportar en cada arranque.
IMPORT_ON_START=False

# ---------------- Proveedores (dual local <-> nube, DEC-17) ----------------
# Los defaults preservan la pila local verificada: Ollama + Chroma + e5-small.
# No toques nada de aquí para la demo local. En la nube (Render) se cambian:
#   EMBEDDINGS_PROVIDER=openai
#   LLM_PROVIDER=openai
#   VECTOR_PROVIDER=qdrant
EMBEDDINGS_PROVIDER=local
LLM_PROVIDER=ollama
VECTOR_PROVIDER=chroma

# ---------------- OpenAI (solo si EMBEDDINGS_PROVIDER/LLM_PROVIDER=openai) ----------------
# Token compartido del curso (carga del profesor). NO lo subas al repositorio.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# ---------------- Qdrant (solo si VECTOR_PROVIDER=qdrant) ----------------
# Qdrant Cloud free tier: 1 GB RAM / 0.5 vCPU / 4 GB disco, permanente, sin tarjeta.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ponyarchive
