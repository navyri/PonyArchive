# PonyArchive — ejemplo de variables de entorno
# Copia este archivo como `backend/.env` y rellena tus valores.
# NUNCA subas el archivo .env real al repositorio (está en .gitignore).

# ---------------- Backend (FastAPI) ----------------
APP_ENV=dev

# Clave para firmar los JWT locales. Debe tener al menos 32 caracteres.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-por-una-propia-de-mas-de-32-caracteres

# Proveedor de autenticación: "local" (JWT propio) o "keycloak" (DEC-05)
AUTH_PROVIDER=local

# Configuración de Keycloak (solo si AUTH_PROVIDER=keycloak)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ponyarchive
KEYCLOAK_CLIENT_ID=ponyarchive-backend
KEYCLOAK_CLIENT_SECRET=

# ---------------- Modelo local (Ollama) ----------------
# Debe estar ejecutándose en la máquina del equipo (DEC-06: túnel en la demo).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=30m

# ---------------- Base de datos vectorial ----------------
VECTOR_DIR=./vectorstore
COLLECTION_NAME=ponyarchive
TOP_K=6
# Umbral mínimo de similitud aceptada (calibrado con preguntas de prueba)
SIMILARITY_THRESHOLD=0.62

# ---------------- Persistencia ----------------
DATABASE_URL=sqlite:///./data/ponyarchive.db

# ---------------- CORS ----------------
# Orígenes permitidos, separados por coma (el frontend en desarrollo usa 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- Integración externa ----------------
# Fuente de metadatos: datos bajo licencia CC BY-SA 3.0 (atribución obligatoria)
PONY_API_URL=https://ponyapi.net/v1
